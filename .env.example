# Cohere: embeddings y generación de respuestas
COHERE_API_KEY=your_cohere_api_key
COHERE_MODELO_CHAT=command-a-03-2025
COHERE_MODELO_EMBEDDING=embed-multilingual-v3.0

# Tavily es opcional. Solo se consulta cuando hay evidencia documental relevante.
TAVILY_API_KEY=your_tavily_api_key
TAVILY_HABILITADO=false
# Lista cerrada de fuentes confiables separadas por comas.
TAVILY_DOMINIOS_PERMITIDOS=docs.python.org,fastapi.tiangolo.com,owasp.org,nist.gov,kubernetes.io,cncf.io,docs.github.com,learn.microsoft.com,docs.aws.amazon.com

CHROMA_DIRECTORIO_PERSISTENCIA=./chroma_db
CHROMA_COLECCION=santos_pegasus_conocimiento
DOCUMENTOS_DIRECTORIO=../Docs
CHUNK_TAMANO=400
CHUNK_SOLAPAMIENTO=60
